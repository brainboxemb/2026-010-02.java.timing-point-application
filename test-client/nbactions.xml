<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>build</actionName>
        <displayName>Build Event Timing Engineering Client</displayName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>install</goal>
        </goals>
        <properties>
            <maven.test.skip>true</maven.test.skip>
        </properties>
    </action>
    <action>
        <actionName>rebuild</actionName>
        <displayName>Clean and Build Event Timing Engineering Client</displayName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>install</goal>
        </goals>
        <properties>
            <maven.test.skip>true</maven.test.skip>
        </properties>
    </action>
    <action>
        <actionName>run</actionName>
        <displayName>Run Event Timing Engineering Client</displayName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>exec:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs></exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass}</exec.args>
            <exec.mainClass>oss.relay.timing.testclient.TestClientApplication</exec.mainClass>
            <exec.executable>${java.home}/bin/java</exec.executable>
            <exec.classpathScope>runtime</exec.classpathScope>
            <exec.longClasspath>true</exec.longClasspath>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <displayName>Debug Event Timing Engineering Client</displayName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>exec:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass}</exec.args>
            <exec.mainClass>oss.relay.timing.testclient.TestClientApplication</exec.mainClass>
            <exec.executable>${java.home}/bin/java</exec.executable>
            <exec.classpathScope>runtime</exec.classpathScope>
            <exec.longClasspath>true</exec.longClasspath>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
