<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>build</actionName>
        <displayName>Build Timing Point Application</displayName>
        <packagings>
            <packaging>pom</packaging>
        </packagings>
        <goals>
            <goal>install</goal>
        </goals>
        <properties>
            <maven.test.skip>true</maven.test.skip>
        </properties>
    </action>

    <action>
        <actionName>rebuild</actionName>
        <displayName>Clean and Build Timing Point Application</displayName>
        <packagings>
            <packaging>pom</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>install</goal>
        </goals>
        <properties>
            <maven.test.skip>true</maven.test.skip>
        </properties>
    </action>

    <action>
        <actionName>CUSTOM-prepare-run</actionName>
        <displayName>Prepare application run</displayName>
        <packagings>
            <packaging>pom</packaging>
        </packagings>
        <goals>
            <goal>install</goal>
        </goals>
        <properties>
            <maven.test.skip>true</maven.test.skip>
        </properties>
    </action>

    <action>
        <actionName>run</actionName>
        <displayName>Run Timing Point Application (reference)</displayName>
        <packagings>
            <packaging>pom</packaging>
        </packagings>
        <preAction>CUSTOM-prepare-run</preAction>
        <basedir>app</basedir>
        <recursive>false</recursive>
        <goals>
            <goal>process-classes</goal>
            <goal>exec:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs></exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <exec.appArgs>--config "${maven.multiModuleProjectDirectory}/config/application.yml"</exec.appArgs>
            <exec.mainClass>oss.relay.eventtiming.timingpoint.app.Main</exec.mainClass>
            <exec.executable>java</exec.executable>
            <exec.classpathScope>runtime</exec.classpathScope>
            <exec.longClasspath>true</exec.longClasspath>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <displayName>Debug Timing Point Application (reference)</displayName>
        <packagings>
            <packaging>pom</packaging>
        </packagings>
        <preAction>CUSTOM-prepare-run</preAction>
        <basedir>app</basedir>
        <recursive>false</recursive>
        <goals>
            <goal>process-classes</goal>
            <goal>exec:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <exec.appArgs>--config "${maven.multiModuleProjectDirectory}/config/application.yml"</exec.appArgs>
            <exec.mainClass>oss.relay.eventtiming.timingpoint.app.Main</exec.mainClass>
            <exec.executable>java</exec.executable>
            <exec.classpathScope>runtime</exec.classpathScope>
            <exec.longClasspath>true</exec.longClasspath>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
